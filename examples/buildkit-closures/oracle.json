            "stage-6": [
              "[stage-6 1/3] FROM docker.io/library/nginx:alpine",
              "[stage-6 2/3] COPY --from=app-base /app/package.json /usr/share/nginx/html/assets/package.json",
              "[stage-6 3/3] COPY --from=build /app/site /usr/share/nginx/html"
            ]
          }
        }
      ]
    }
  ]
}
