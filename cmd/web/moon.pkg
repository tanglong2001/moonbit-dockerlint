import {
  "tanglong2001/dockerlint" @lib,
  "moonbitlang/core/json",
}

supported_targets = "js"

pkgtype(kind: "executable")

options(
  link: {
    "js": {
      "exports": [
        "run",
        "diagnostics",
        "stage_graph",
        "configured",
        "variables",
        "impact",
        "compare_impact",
        "context_plan",
        "source_matches",
      ],
      "format": "esm",
    },
  },
)
