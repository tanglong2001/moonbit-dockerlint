import {
  "localreview/dockerlint" @lib,
}

supported_targets = "js"

pkgtype(kind: "executable")

options(
  link: {
    "js": {
      "exports": [
        "run",
        "diagnostics",
        "stage_graph",
        "configured",
        "variables",
      ],
      "format": "esm",
    },
  },
)
